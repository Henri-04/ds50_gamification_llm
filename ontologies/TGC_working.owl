    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sioc:has_member</AbbreviatedIRI>
        <Literal>each usergroup has one or more users</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sioc:has_usergroup</AbbreviatedIRI>
        <Literal>each space has user groups</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sioc:member_of</AbbreviatedIRI>
        <Literal>each user is a member of user group</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>sioc:usergroup_of</AbbreviatedIRI>
        <Literal>each user group is a user group of a space</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2.1:Activity</AbbreviatedIRI>
        <Literal>represents the processes and procedures done over time</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2.1:Space</AbbreviatedIRI>
        <Literal>A collaborative area with user accounts that are members in that space to help share resources</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2.1:UserAccount</AbbreviatedIRI>
        <Literal>Each person involved in the work process has one account or more. The account is
associated with a role.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2.1:UserGroup</AbbreviatedIRI>
        <Literal>Users can be members in different
groups, and each group has a corresponding shared space allowing its members to collaborate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:AccessResourceActivity</AbbreviatedIRI>
        <Literal>The activity of accessing a resource in the platform;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:AddResourceActivity</AbbreviatedIRI>
        <Literal>The activity of adding a resource in the platform which does not
exist before, but is not created originally by the user who adds it;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:Agent</AbbreviatedIRI>
        <Literal>The Agent class is the class of agents; things that do stuff. A well known sub-class is Person, representing people. Other kinds of agents include Organization and Group.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:Agent</AbbreviatedIRI>
        <Literal>The Group class represents a collection of individual agents (and may itself play the role of a Agent, ie. something that can perform actions).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:Agent</AbbreviatedIRI>
        <Literal>An agent (eg. person, group, software or physical artifact).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:CompositeResource</AbbreviatedIRI>
        <Literal>Composite resource contains one or more simple resource</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:CreateResourceActivity</AbbreviatedIRI>
        <Literal>The activity of creating an original resource in the platform,
e.g., creating a note;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:DeleteResourceActivity</AbbreviatedIRI>
        <Literal>The activity of deleting a resource in the platform;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:Document</AbbreviatedIRI>
        <Literal>in memorae, document is equivalent to bibo:document which consists of: image, article, audio, book, slideshow, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:Document</AbbreviatedIRI>
        <Literal>provide structured content and information on specific subjects or topics in the form of e-books, textbooks and reference materials.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:IndexKey</AbbreviatedIRI>
        <Literal>Each resource is referenced by an index key that is visible at a group space.
This ties a resource to a group</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:InteractionActivity</AbbreviatedIRI>
        <Literal>representing interaction activities and administration activities in the virtual environment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:InteractionActivityOnResources</AbbreviatedIRI>
        <Literal>Each interaction activity takes place over a time period and acts on or
with resources. This can compose and generate individual activity traces. Each trace belongs
to an individual and is linked to the index key of the concerned resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:InteractionActivityOnResources</AbbreviatedIRI>
        <Literal>representing interaction activities in the virtual environment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:ModifyResourceActivity</AbbreviatedIRI>
        <Literal>The activity of modifying a resource in the platform;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:Person</AbbreviatedIRI>
        <Literal>Each person involved in the work process has one account or more. 
Every person has a personal group which holds a personal sharing space.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:Resource</AbbreviatedIRI>
        <Literal>Resources can be simple resource or composite resource</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:Resource</AbbreviatedIRI>
        <Literal>encompass materials and tools supporting teaching and
learning, such as textbooks, online courses, multimedia content, software,
research articles, and interactive resources</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:ShareResourceActivity</AbbreviatedIRI>
        <Literal>The activity of sharing a resource in the platform, e.g., sharing
with another group a document which is already added to the platform.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:SimpleResource</AbbreviatedIRI>
        <Literal>A single resource like game element, document, video, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2:Vote</AbbreviatedIRI>
        <Literal>The vote is modeled as a simple resource for mainly three reasons:
• Modeling Vote as a resource make it possible to index it by an index key that is
visible in a certain sharing space;
• A vote is created by a user;
• Vote can further be used for reasoning the competency of a user who has created,
shared or modified the voted resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:Vote</AbbreviatedIRI>
        <Literal>Users have different preferences on resources for different purposes. They
express these preferences on the resources by giving a value between 1 and 5, the higher the value, the more they appreciate the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:has_user_account</AbbreviatedIRI>
        <Literal>person can have one or more user accounts</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2:index</AbbreviatedIRI>
        <Literal>an index key  indexes a resource&apos;s reference key</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2SOIS:ReferenceKey</AbbreviatedIRI>
        <Literal>provide users access to the resource through a reference key.
Each resource has reference key that is indexed by index key</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <AbbreviatedIRI>MC2SOIS:ReferenceKey</AbbreviatedIRI>
        <Literal>IndexKey</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>MC2SOIS:User</AbbreviatedIRI>
        <Literal>Prof.Abel requested to use Mc2:User, however, it is of no use since it is not really associated to anything, 
MC2:has_user_account has domain as MC2:Person and range as MC2:UserAccount
So a person can directly have a user account

mc2sois is no loger used.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2SOIS:User</AbbreviatedIRI>
        <Literal>users who communicate with each other by using the Usergroup class. This class is useful when describing groups of users within a social Web application.

A Person can exist without being a user in a group</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="owl:deprecated"/>
        <AbbreviatedIRI>MC2SOIS:User</AbbreviatedIRI>
        <Literal></Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2SOIS:has_reference</AbbreviatedIRI>
        <Literal>a resource has a reference key</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <AbbreviatedIRI>MC2SOIS:utilizes</AbbreviatedIRI>
        <Literal>each activity utilizes an index key</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
