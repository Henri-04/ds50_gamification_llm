    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:title"/>
        <Literal xml:lang="en">Teacher in Gamified Context Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">An ontology for modeling teachers, gamified resources, game elements, educational topics, and collaborative sharing spaces in gamified e-learning environments.</Literal>
    </Annotation>
    <Annotation>
