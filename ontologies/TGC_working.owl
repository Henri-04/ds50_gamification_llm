    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:description"/>
        <Literal xml:lang="en">The TGC ontology models teachers, pedagogical resources, gamified resources, educational topics, and collaboration spaces in gamified e-learning environments.</Literal>
    </Annotation>
