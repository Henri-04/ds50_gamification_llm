                <ObjectProperty IRI="#CoversTopic"/>
                <Variable IRI="#l"/>
                <Variable IRI="#et"/>
            </ObjectPropertyAtom>
        </Body>
        <Head>
            <ObjectPropertyAtom>
                <ObjectProperty IRI="#hasEducationalTopic"/>
                <Variable IRI="#c"/>
                <Variable IRI="#et"/>
            </ObjectPropertyAtom>
        </Head>
    </DLSafeRule>
