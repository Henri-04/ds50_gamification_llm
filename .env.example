# Copier ce fichier en `.env` puis remplir les deux clés.
#   cp .env.example .env

# ── REQUIS ────────────────────────────────────────────────────────
# Groq — Agent 1, Agent 2, Bridge.  Clé : https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# NVIDIA — Agent 3.  Clé : https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# ── OPTIONNEL : tracing LangSmith (non requis pour lancer le projet) ─
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=ds50-agent-gamification-v0